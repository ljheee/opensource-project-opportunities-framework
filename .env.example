# Required
GITHUB_TOKEN=your_github_personal_access_token_here

# Optional
# Set to true to enable LLM analysis (requires Claude CLI or compatible tool)
USE_LLM=false

# Custom CLI tool for LLM analysis (default: claude)
# Supports two calling conventions:
#   - Claude / gemini / aider: prompt passed via -p argument
#     CLI_TOOL="claude --dangerously-skip-permissions"
#   - Cursor agent: prompt passed via stdin (detected by "agent" or "cursor-agent" in command)
#     CLI_TOOL="agent --force"
# CLI_TOOL="claude --dangerously-skip-permissions"
